#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

source "$repo_root/tools/git/commit_mode.sh"
source "$repo_root/tools/git-hooks/commit_files.sh"

commit_base_tree="$(proposed_commit_base_tree)"

# Only lint files that the hook knows how to check. Both languages follow the
# complete tree proposed by this commit relative to its parent tree.
mapfile -t python_files < <(
  list_proposed_commit_files "$commit_base_tree" -- '*.py'
)

status=0
readonly CLANG_TIDY_PARALLELISM=10

mapfile -t cpp_files < <(
  list_proposed_commit_files "$commit_base_tree" -- \
    '*.cc' '*.cpp' '*.cxx' '*.h' '*.hpp' '*.hh'
)

mapfile -t cpp_files < <(
  for file in "${cpp_files[@]}"; do
    case "$file" in
      src/*|test/*)
        printf '%s\n' "$file"
        ;;
    esac
  done
)

if [[ "${#python_files[@]}" -gt 0 ]]; then
  # Ruff is imported through Bazel/Nix, so the hook does not depend on system
  # Python or a globally installed formatter.
  echo "bazel --batch run //tools/python:pyformat -- --check ."
  if ! bazel --batch run //tools/python:pyformat -- --check .; then
    status=1
  fi
fi

if [[ "${#cpp_files[@]}" -eq 0 ]]; then
  exit "$status"
fi

# The C++ checks use LLVM tools directly. On NixOS they come from clang-tools.
if ! command -v clang-tidy >/dev/null 2>&1; then
  cat >&2 <<'EOF'
clang-tidy is required for this repo's pre-commit hook.

On NixOS, install the package that provides clang-tidy:
  clang-tools

Temporary shell:
  nix shell nixpkgs#clang-tools
EOF
  exit 1
fi

if ! command -v clang-format >/dev/null 2>&1; then
  cat >&2 <<'EOF'
clang-format is required for this repo's pre-commit hook.

On NixOS, install the package that provides clang-format:
  clang-tools

Temporary shell:
  nix shell nixpkgs#clang-tools
EOF
  exit 1
fi

# clang-tidy reads Bazel's real compile flags, include paths, and external deps
# from compile_commands.json. Refresh it before linting so we do not guess flags.
tools/bazel/refresh_compile_commands.sh

# Format every changed C++ header/source. clang-format enforces east const.
for file in "${cpp_files[@]}"; do
  [[ -f "$file" ]] || continue
  echo "clang-format --dry-run $file"
  if ! clang-format --dry-run --Werror "$file"; then
    status=1
  fi
done

filter_clang_tidy_output() {
  sed -E \
    -e '/^[0-9]+ warnings generated\.$/d' \
    -e '/^Suppressed [0-9]+ warnings \(.* in non-user code\)\.$/d' \
    -e '/^Use -header-filter=.*$/d'
}

run_clang_tidy_file() {
  local file="$1"
  local output_file="$2"
  local status_file="$3"
  local tidy_output

  if ! tidy_output="$(clang-tidy "$file" --quiet -p "$repo_root" 2>&1)"; then
    printf '1\n' >"$status_file"
  else
    printf '0\n' >"$status_file"
  fi

  if [[ -n "$tidy_output" ]]; then
    printf '%s\n' "$tidy_output" | filter_clang_tidy_output >"$output_file"
  else
    : >"$output_file"
  fi
}

tidy_temp_dir="$(mktemp -d)"
trap 'rm -rf "$tidy_temp_dir"' EXIT
tidy_pids=()
tidy_output_files=()
tidy_status_files=()
tidy_index=0

finish_clang_tidy_batch() {
  local pid
  local output_file
  local status_file
  local status_value

  for pid in "${tidy_pids[@]}"; do
    if ! wait "$pid"; then
      status=1
    fi
  done

  for output_file in "${tidy_output_files[@]}"; do
    if [[ -s "$output_file" ]]; then
      cat "$output_file"
    fi
  done

  for status_file in "${tidy_status_files[@]}"; do
    if [[ ! -f "$status_file" ]]; then
      status=1
      continue
    fi
    status_value="$(<"$status_file")"
    if [[ "$status_value" != "0" ]]; then
      status=1
    fi
  done

  tidy_pids=()
  tidy_output_files=()
  tidy_status_files=()
}

# Run clang-tidy through the compile database instead of passing manual flags.
for file in "${cpp_files[@]}"; do
  [[ -f "$file" ]] || continue
  echo "clang-tidy $file"

  tidy_output_file="$tidy_temp_dir/$tidy_index.out"
  tidy_status_file="$tidy_temp_dir/$tidy_index.status"
  run_clang_tidy_file "$file" "$tidy_output_file" "$tidy_status_file" &
  tidy_pids+=("$!")
  tidy_output_files+=("$tidy_output_file")
  tidy_status_files+=("$tidy_status_file")
  tidy_index=$((tidy_index + 1))

  if [[ "${#tidy_pids[@]}" -ge "$CLANG_TIDY_PARALLELISM" ]]; then
    finish_clang_tidy_batch
  fi
done

if [[ "${#tidy_pids[@]}" -gt 0 ]]; then
  finish_clang_tidy_batch
fi

exit "$status"

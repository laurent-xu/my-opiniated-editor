# Copy to ~/.config/my-opiniated-editor/bridge-7683.env.
MOE_BRIDGE_HTTP_PORT=17683
MOE_BRIDGE_HTTPS_INTERFACE=127.0.0.1

# Replace the first entry with the exact URL printed by `tailscale funnel`.
# Entries are comma-separated exact HTTPS origins without trailing slashes.
# MOE_BRIDGE_ALLOWED_ORIGIN=https://nixos.example-tailnet.ts.net:10000,https://127.0.0.1:7683

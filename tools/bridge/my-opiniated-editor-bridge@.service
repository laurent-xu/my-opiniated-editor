[Unit]
Description=My Opiniated Editor loopback parent PTY bridge for HTTPS port %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/my-opiniated-editor/main
EnvironmentFile=-%h/.config/my-opiniated-editor/bridge.env
EnvironmentFile=%h/.config/my-opiniated-editor/bridge-%i.env
ExecStart=%h/my-opiniated-editor/main/tools/bridge/run_bridge.sh ${MOE_BRIDGE_HTTP_PORT} %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

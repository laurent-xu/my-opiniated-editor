# Optionally copy this file to ~/.config/my-opiniated-editor/bridge.env.
#
# Keep that real file private:
#   chmod 600 ~/.config/my-opiniated-editor/bridge.env

# The C++ bridge and HTTPS proxy are loopback-only unless an instance file
# explicitly opts into LAN access.
MOE_BRIDGE_HTTPS_INTERFACE=127.0.0.1

# Set this per instance to reject WebSocket handshakes from every browser
# origin except these comma-separated exact HTTPS origins. Do not include
# trailing slashes.
# MOE_BRIDGE_ALLOWED_ORIGIN=https://editor.example.ts.net,https://127.0.0.1:7683

# Defaults point at these files under ~/.secrets. Override only when needed.
# MOE_BRIDGE_TLS_CERTIFICATE=/absolute/path/to/certificate.pem
# MOE_BRIDGE_TLS_CERTIFICATE_KEY=/absolute/path/to/certificate-key.pem
# MOE_BRIDGE_PASSWORD_FILE=/absolute/path/to/password-hash

# Browser sessions default to the public port's instance state directory.
# MOE_BRIDGE_SESSION_DATABASE=/absolute/path/to/browser-sessions.sqlite3

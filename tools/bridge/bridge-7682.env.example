# Copy to ~/.config/my-opiniated-editor/bridge-7682.env.
MOE_BRIDGE_HTTP_PORT=17682
MOE_BRIDGE_HTTPS_INTERFACE=127.0.0.1

# Replace the first entry with the exact URL printed by `tailscale funnel`.
# Port 443 is omitted from a browser origin because it is the HTTPS default.
# Entries are comma-separated exact HTTPS origins without trailing slashes.
# MOE_BRIDGE_ALLOWED_ORIGIN=https://nixos.example-tailnet.ts.net,https://127.0.0.1:7682

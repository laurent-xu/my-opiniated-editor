# Repo-local allow rules for commands that repeatedly need host access.
#
# These rules are intentionally narrower than the user's global rules. They
# apply only when this repository is trusted, and they do not grant an agent
# permission to perform work that the user did not request.

prefix_rule(
    pattern = ["bazel", "--batch", "test"],
    decision = "allow",
    justification = "Run this repository's Bazel tests, including dependency access through Nix.",
    match = [
        "bazel --batch test //...",
        "bazel --batch test //src/bridge:parent_pty_session_test",
    ],
    not_match = [
        "bazel --batch run //src/bridge:parent_ws_bridge",
    ],
)

prefix_rule(
    pattern = ["bazel", "test"],
    decision = "allow",
    justification = "Run the repository's documented default Bazel confidence command.",
    match = [
        "bazel test //...",
        "bazel test //src/bridge:parent_pty_session_test",
    ],
    not_match = [
        "bazel run //src/bridge:parent_ws_bridge",
    ],
)

prefix_rule(
    pattern = ["bazel", "--batch", "run", "//tools/python:pyformat"],
    decision = "allow",
    justification = "Run the repository-owned Python formatter target.",
    match = [
        "bazel --batch run //tools/python:pyformat -- --check .",
        "bazel --batch run //tools/python:pyformat -- .",
    ],
    not_match = [
        "bazel --batch run //src/bridge:parent_ws_bridge",
    ],
)

prefix_rule(
    pattern = ["tools/bazel/refresh_compile_commands.sh"],
    decision = "allow",
    justification = "Refresh compile_commands.json through the repository's safe wrapper.",
    match = [
        "tools/bazel/refresh_compile_commands.sh",
    ],
    not_match = [
        "bazel run //:refresh_compile_commands",
    ],
)

prefix_rule(
    pattern = ["tools/git-hooks/pre-commit"],
    decision = "allow",
    justification = "Run the repository's tracked pre-commit validation gate.",
    match = [
        "tools/git-hooks/pre-commit",
    ],
    not_match = [
        "git commit",
    ],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Update this repository's Git index without a repeated approval prompt.",
    match = [
        "git add -A",
        "git add src/bridge/browser_assets.cc",
        "git add src/parent/BUILD.bazel src/parent/terminal_screen.cc",
    ],
    not_match = [
        "git commit",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Inspect working-tree or staged changes without a repeated approval prompt.",
    match = [
        "git diff",
        "git diff --check",
        "git diff --cached --check",
        "git diff --stat",
    ],
    not_match = [
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "branch", "--show-current"],
    decision = "allow",
    justification = "Let the manual-test skill verify that it is operating on a named feature branch.",
    match = [
        "git branch --show-current",
    ],
    not_match = [
        "git branch --delete feature",
    ],
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Let the manual-test skill inspect worktree and rebase state.",
    match = [
        "git status --short --branch",
        "git status --short",
    ],
    not_match = [
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "fetch", "origin", "main"],
    decision = "allow",
    justification = "Let the manual-test skill update only the origin/main remote-tracking branch before rebasing.",
    match = [
        "git fetch origin main",
    ],
    not_match = [
        "git fetch another-remote main",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "rebase", ["main", "origin/main", "--continue"]],
    decision = "allow",
    justification = "Let the manual-test skill rebase onto main or origin/main and continue after resolving conflicts.",
    match = [
        "git rebase main",
        "git rebase origin/main",
        "git rebase --continue",
    ],
    not_match = [
        "git rebase --skip",
        "git rebase another-branch",
    ],
)

prefix_rule(
    pattern = ["git", "-c", "core.editor=true", "rebase", "--continue"],
    decision = "allow",
    justification = "Let the manual-test skill continue a conflict-resolved rebase without opening an editor.",
    match = [
        "git -c core.editor=true rebase --continue",
    ],
    not_match = [
        "git -c core.editor=true rebase --skip",
        "git -c alias.run=!sh run",
    ],
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Let the manual-test skill inspect replayed commits and conflict stages.",
    match = [
        "git show REBASE_HEAD",
        "git show :1:src/bridge/server.cc",
        "git show :2:src/bridge/server.cc",
        "git show :3:src/bridge/server.cc",
    ],
    not_match = [
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "rm", "--"],
    decision = "allow",
    justification = "Let the manual-test skill stage an intended deletion while resolving a rebase conflict.",
    match = [
        "git rm -- src/bridge/obsolete.cc",
    ],
    not_match = [
        "git rm -r .",
        "rm src/bridge/obsolete.cc",
    ],
)

prefix_rule(
    pattern = ["git", "merge-base", "--is-ancestor", "origin/main", "HEAD"],
    decision = "allow",
    justification = "Let the manual-test skill verify that the rebased branch contains origin/main.",
    match = [
        "git merge-base --is-ancestor origin/main HEAD",
    ],
    not_match = [
        "git merge-base --is-ancestor another-branch HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "rev-parse", ["--show-toplevel", "HEAD"]],
    decision = "allow",
    justification = "Let the manual-test skill locate the selected worktree and report its deployed HEAD commit.",
    match = [
        "git rev-parse --show-toplevel",
        "git rev-parse HEAD",
    ],
    not_match = [
        "git rev-parse another-branch",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Create a requested local commit; repository instructions still control when commits are in scope.",
    match = [
        "git commit -m \"Fix browser terminal rendering\"",
        "git commit -m \"Extract terminal screen library\"",
    ],
    not_match = [
        "git push",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["tools/git/commit"],
    decision = "allow",
    justification = "Create requested commits through the repository wrapper so amend-aware checks receive an explicit mode.",
    match = [
        "tools/git/commit -m \"Extract terminal screen library\"",
        "tools/git/commit --amend --no-edit",
    ],
    not_match = [
        "git push",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = [
        "install",
        "-m",
        "755",
        "tools/git-hooks/pre-commit",
        ".git/hooks/pre-commit",
    ],
    decision = "allow",
    justification = "Install the tracked repository hook into this worktree's Git metadata.",
    match = [
        "install -m 755 tools/git-hooks/pre-commit .git/hooks/pre-commit",
    ],
    not_match = [
        "install -m 755 tools/git-hooks/pre-commit /usr/local/bin/pre-commit",
    ],
)

prefix_rule(
    pattern = ["ps", "-eo", "pid,ppid,stat,comm,args"],
    decision = "allow",
    justification = "Inspect host process state while diagnosing Bazel and bridge processes.",
    match = [
        "ps -eo pid,ppid,stat,comm,args",
        "ps -eo pid,ppid,stat,comm,args | rg parent_ws_bridge",
    ],
    not_match = [
        "kill 1234",
    ],
)

prefix_rule(
    pattern = ["systemctl", "--user", "is-active"],
    decision = "allow",
    justification = "Read whether a user service, including a port-keyed bridge instance, is active.",
    match = [
        "systemctl --user is-active my-opiniated-editor-bridge.service",
        "systemctl --user is-active my-opiniated-editor-bridge@7683.service",
    ],
    not_match = [
        "systemctl --user restart my-opiniated-editor-bridge@7683.service",
        "systemctl --user stop my-opiniated-editor-bridge@7683.service",
    ],
)

prefix_rule(
    pattern = [
        "systemctl",
        "--user",
        ["status", "show", "is-active"],
        "my-opiniated-editor-bridge.service",
    ],
    decision = "allow",
    justification = "Read the status of this repository's user bridge service.",
    match = [
        "systemctl --user status my-opiniated-editor-bridge.service --no-pager",
        "systemctl --user show my-opiniated-editor-bridge.service --property=MainPID",
        "systemctl --user is-active my-opiniated-editor-bridge.service",
    ],
    not_match = [
        "systemctl --user status another.service",
        "systemctl --user stop my-opiniated-editor-bridge.service",
    ],
)

prefix_rule(
    pattern = ["tools/bridge/restart_bridge.sh"],
    decision = "allow",
    justification = "Build and restart only this repository's user bridge service through its tracked helper.",
    match = [
        "tools/bridge/restart_bridge.sh",
    ],
    not_match = [
        "systemctl --user restart another.service",
    ],
)

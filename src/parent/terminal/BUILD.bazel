cc_library(
    name = "content_pty_session",
    srcs = ["content_pty_session.cc"],
    hdrs = ["content_pty_session.h"],
    visibility = ["//src/parent:__pkg__"],
    deps = [
        "//src/base:file_descriptor",
        "//src/base:owned_file_descriptor",
        "//src/base:process_id",
        "//src/base:terminal_size",
        "//src/process:process_exit_status",
        "//third_party/system:libutil",
    ],
)

cc_library(
    name = "terminal_screen",
    srcs = ["terminal_screen.cc"],
    hdrs = [
        "terminal_position.h",
        "terminal_screen.h",
    ],
    visibility = ["//src/parent:__pkg__"],
    deps = [
        "//src/base:terminal_size",
        "//third_party/system:libvterm_neovim",
    ],
)

cc_test(
    name = "terminal_screen_test",
    srcs = ["terminal_screen_test.cc"],
    deps = [
        ":terminal_screen",
        "@googletest//:gtest_main",
    ],
    tags = ["unit"],
)

cc_library(
    name = "terminal_screen_snapshot_test_support",
    testonly = True,
    hdrs = ["terminal_screen_snapshot_test_support.h"],
    deps = [":terminal_screen"],
)

[
    cc_test(
        name = test_name,
        srcs = [test_name + ".cc"],
        deps = [
            ":terminal_screen_snapshot_test_support",
            "@googletest//:gtest_main",
        ],
        tags = ["unit"],
    )
    for test_name in [
        "terminal_screen_color_snapshot_test",
        "terminal_screen_erase_snapshot_test",
        "terminal_screen_region_snapshot_test",
        "terminal_screen_state_snapshot_test",
    ]
]

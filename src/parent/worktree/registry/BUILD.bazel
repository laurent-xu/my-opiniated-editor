proto_library(
    name = "worktree_registry_proto",
    srcs = ["worktree_registry.proto"],
)

cc_proto_library(
    name = "worktree_registry_cc_proto",
    deps = [":worktree_registry_proto"],
)

cc_library(
    name = "worktree_registry_store",
    srcs = ["worktree_registry_store.cc"],
    hdrs = ["worktree_registry_store.h"],
    visibility = [
        "//src/parent:__pkg__",
        "//src/parent/runtime:__pkg__",
        "//src/parent/worktree:__pkg__",
        "//src/parent/worktree/overlay:__pkg__",
        "//src/parent/worktree/provision:__pkg__",
        "//src/parent/worktree/registration:__pkg__",
    ],
    deps = [
        ":worktree_registry_cc_proto",
        "//src/base:file_descriptor",
        "//src/base:owned_file_descriptor",
    ],
)

cc_library(
    name = "worktree_registry_store_test_support",
    testonly = True,
    hdrs = ["worktree_registry_store_test_support.h"],
    deps = [
        ":worktree_registry_store",
        "//src/parent/test/support:test_paths",
    ],
)

cc_test(
    name = "worktree_registry_store_path_test",
    srcs = ["worktree_registry_store_path_test.cc"],
    deps = [
        ":worktree_registry_store",
        "//src/parent/test/support:environment_guard",
        "//src/parent/test/support:test_paths",
        "@googletest//:gtest_main",
    ],
    tags = ["unit"],
)

[
    cc_test(
        name = test_name,
        srcs = [test_name + ".cc"],
        deps = [
            ":worktree_registry_store",
            ":worktree_registry_store_test_support",
            "@googletest//:gtest_main",
        ],
        tags = ["unit"],
    )
    for test_name in [
        "worktree_registry_store_failure_safety_test",
        "worktree_registry_store_load_test",
        "worktree_registry_store_save_test",
    ]
]

test_suite(
    name = "worktree_registry_store_test",
    tests = [
        ":worktree_registry_store_failure_safety_test",
        ":worktree_registry_store_load_test",
        ":worktree_registry_store_path_test",
        ":worktree_registry_store_save_test",
    ],
    tags = ["unit"],
    visibility = ["//src/parent/worktree:__pkg__"],
)

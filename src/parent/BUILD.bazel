proto_library(
    name = "worktree_registry_proto",
    srcs = ["worktree_registry.proto"],
)

cc_proto_library(
    name = "worktree_registry_cc_proto",
    deps = [":worktree_registry_proto"],
)

cc_library(
    name = "worktree_registry_store",
    srcs = ["worktree_registry_store.cc"],
    hdrs = ["worktree_registry_store.h"],
    deps = [
        ":worktree_registry_cc_proto",
        "//src/base:file_descriptor",
        "//src/base:owned_file_descriptor",
    ],
)

cc_library(
    name = "parent_lib",
    srcs = [
        "content_pty_session.cc",
        "terminal_screen.cc",
        "tray.cc",
        "tray_id.cc",
        "tray_manager.cc",
        "tray_number.cc",
        "workspace_parent.cc",
    ],
    hdrs = [
        "content_pty_session.h",
        "terminal_screen.h",
        "tray.h",
        "tray_config.h",
        "tray_id.h",
        "tray_manager.h",
        "tray_number.h",
        "tray_output_source.h",
        "tray_snapshot.h",
        "workspace_parent.h",
    ],
    deps = [
        "//src/base:file_descriptor",
        "//src/base:owned_file_descriptor",
        "//src/base:process_id",
        "//third_party/system:libvterm_neovim",
        "//third_party/system:libutil",
    ],
)

cc_binary(
    name = "workspace_parent",
    srcs = ["main.cc"],
    visibility = [
        "//src/bridge:__pkg__",
        "//test/integration:__pkg__",
    ],
    deps = [":parent_lib"],
)

cc_test(
    name = "workspace_parent_test",
    srcs = ["workspace_parent_test.cc"],
    deps = [
        ":parent_lib",
        "@googletest//:gtest_main",
    ],
    tags = ["unit"],
)

cc_test(
    name = "terminal_screen_test",
    srcs = ["terminal_screen_test.cc"],
    deps = [
        ":parent_lib",
        "@googletest//:gtest_main",
    ],
    tags = ["unit"],
)

cc_test(
    name = "tray_manager_test",
    srcs = ["tray_manager_test.cc"],
    deps = [
        ":parent_lib",
        "@googletest//:gtest_main",
    ],
    tags = ["integration"],
)

cc_test(
    name = "worktree_registry_store_test",
    srcs = ["worktree_registry_store_test.cc"],
    deps = [
        ":worktree_registry_store",
        "@googletest//:gtest_main",
    ],
    tags = ["unit"],
)
